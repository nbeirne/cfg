" Plain-Vim entry point: ln -s ~/.cfg/vim/vimrc ~/.vimrc
" resolve() follows that symlink back to this repo, so no ~/.vim is needed.
let s:dir = fnamemodify(resolve(expand('<sfile>:p')), ':h')
let &runtimepath = s:dir . ',' . &runtimepath

" nvim defaults that Vim lacks. Before base.vim, since `syntax on` would reset its colorscheme.
filetype plugin indent on
syntax on
set history=10000
set hidden
set autoread
set nrformats-=octal
set autoindent
set smarttab
set incsearch
set hlsearch
set sidescroll=1
set laststatus=2
set ruler
" nvim has belloff=all, so it never beeps.
set visualbell

runtime base.vim

set viminfo+=n~/.local/share/viminfo
set mouse=a
set ttymouse=sgr
set modelines=1

if has('termguicolors')
  " Vim only knows the truecolor escapes for xterm-like $TERM, not tmux/screen.
  if &term =~# '^\(tmux\|screen\)'
    let &t_8f = "\<Esc>[38;2;%lu;%lu;%lum"
    let &t_8b = "\<Esc>[48;2;%lu;%lu;%lum"
  endif
  set termguicolors
endif
